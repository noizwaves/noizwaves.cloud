{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 25,
  "ignorePaths": [
    "_inactive/**"
  ],
  "packageRules": [
    {
      "description": "Keep Immich application images together when a registry lookup fails",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich monorepo",
      "minimumGroupSize": 2
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Allow Plex upgrades when the release hash changes",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$"
    },
    {
      "description": "Track application versions while ignoring LinuxServer build numbers",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "lscr.io/linuxserver/sabnzbd",
        "lscr.io/linuxserver/homeassistant",
        "lscr.io/linuxserver/freshrss",
        "lscr.io/linuxserver/syncthing"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls\\d+$"
    },
    {
      "description": "Track four-part application versions while ignoring LinuxServer build numbers",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/lidarr",
        "lscr.io/linuxserver/prowlarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls\\d+$"
    },
    {
      "description": "Keep plain MariaDB tags on their existing versioning while tracking Alpine revisions and ignoring LinuxServer build numbers on full tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "lscr.io/linuxserver/mariadb",
        "lscr.io/linuxserver/nginx"
      ],
      "matchCurrentValue": "/-ls\\d+$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)-ls\\d+$"
    },
    {
      "description": "Track Resilio application and package revisions while ignoring LinuxServer build numbers",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/resilio-sync"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-(?<revision>\\d+)-ls\\d+$"
    }
  ]
}
