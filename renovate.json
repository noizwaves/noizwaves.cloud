{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "ignorePaths": [
    "_inactive/**"
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Track LinuxServer build numbers while excluding unstable and architecture-specific tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "matchCurrentValue": "/-ls\\d+$/",
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?(?:-r?\\d+)?-ls\\d+$/",
      "versioning": "loose"
    }
  ]
}
